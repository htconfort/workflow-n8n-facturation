# SUPABASE — service_role key (pas anon_key, on a besoin du bypass RLS)
SUPABASE_URL=https://ryttyzkpbpuqrdlxweth.supabase.co
SUPABASE_SERVICE_KEY=REMPLACER_PAR_LA_SERVICE_ROLE_KEY

# N8N
N8N_BASE_URL=https://n8n.myconfort.fr/webhook

# COLISSIMO (via proxy Netlify — pas besoin de credentials directement)
