# =============================================================================
# CLES API pour le script facture-manuscrite-colissimo autonome
# =============================================================================
# COPIER CE FICHIER sur le portable dans le meme dossier que le script :
#   cp facture-colissimo.env.example facture-colissimo.env
# Puis remplir les valeurs marquees "REMPLACER"
# NE JAMAIS COMMITER facture-colissimo.env (ignore par .gitignore)
# =============================================================================

# SUPABASE — service_role key (pas anon_key, on a besoin du bypass RLS)
SUPABASE_URL=https://ryttyzkpbpuqrdlxweth.supabase.co
SUPABASE_SERVICE_KEY=REMPLACER_PAR_LA_SERVICE_ROLE_KEY

# N8N
N8N_BASE_URL=https://n8n.myconfort.fr/webhook

# COLISSIMO (via proxy Netlify — pas besoin de credentials directement)
COLISSIMO_PROXY_URL=https://myconfortfactures.netlify.app/.netlify/functions/colissimo-proxy/generateLabel

# EXPRESS CATALAN
# Auth = Basic (USERNAME:PASSWORD) sur POST /v1/token/{STATION} -> renvoie JWT
# (valide ~23h), puis Bearer JWT sur les requetes suivantes.
EXPRESS_CATALAN_API_URL=https://express-catalan-api.station-chargeur.com
EXPRESS_CATALAN_USERNAME=REMPLACER_PAR_USERNAME
EXPRESS_CATALAN_PASSWORD=REMPLACER_PAR_PASSWORD
EXPRESS_CATALAN_STATION=REMPLACER_PAR_NUMERO_STATION
